# ── Supabase ──────────────────────────────────────────────────────────────────
# Project URL และ anon key ได้จาก: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Internal encryption ───────────────────────────────────────────────────────
# ใช้เข้ารหัสข้อมูลธุรกรรมก่อนลง DB
# สร้างด้วย: openssl rand -hex 32
INTERNAL_ENCRYPTION_SECRET=replace-with-a-long-random-secret
INTERNAL_ENCRYPTION_SALT=replace-with-a-long-random-salt

# ── Row-level tamper detection ────────────────────────────────────────────────
# ใช้ HMAC-SHA256 เซ็นทุก Row ก่อนลง DB ป้องกัน row-swap / direct-DB tamper
# สร้างด้วย: openssl rand -hex 32
# ต้องแยก key คนละอันกับ INTERNAL_ENCRYPTION_SECRET
HMAC_SIGNING_KEY=replace-with-another-random-hex-64

# ── NVIDIA AI ─────────────────────────────────────────────────────────────────
# API key ได้จาก: https://build.nvidia.com → Get API Key
NVIDIA_API_KEY=nvapi-...
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_SLIP_MODEL=deepseek-ai/deepseek-v4-flash
NVIDIA_SUMMARY_MODEL=nvidia/llama-3.1-nemotron-ultra-253b-v1

# ── Cron ──────────────────────────────────────────────────────────────────────
# ใช้ protect /api/cron/daily-summary จาก Vercel Cron
# สร้างด้วย: openssl rand -hex 32
CRON_SECRET=replace-with-a-long-random-secret
